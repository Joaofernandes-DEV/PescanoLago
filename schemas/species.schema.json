{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Joaofernandes-DEV/PescanoLago/schemas/species.schema.json",
  "title": "Espécies de peixe",
  "description": "Catálogo de espécies do Game Design (tabelas de peixes, p. 8-9). Os números são valores iniciais de balanceamento.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "species"],
  "properties": {
    "schema_version": { "const": 1 },
    "species": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/species" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "species": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "common_name",
        "scientific_name",
        "rarity",
        "regions",
        "ideal_baits",
        "max_weight_kg",
        "points",
        "introduced_in_brazil",
        "fight"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "common_name": {
          "description": "Nome popular em pt-BR, como no Game Design.",
          "type": "string",
          "minLength": 2
        },
        "scientific_name": {
          "description": "Gênero e epíteto (ou 'sp.'), como no Game Design.",
          "type": "string",
          "pattern": "^[A-Z][a-z]+ ([a-z]+|sp\\.)$"
        },
        "rarity": {
          "enum": ["common", "uncommon", "rare", "epic", "legendary", "unique_legendary"]
        },
        "regions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "ideal_baits": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "max_weight_kg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "points": {
          "type": "integer",
          "minimum": 1
        },
        "introduced_in_brazil": {
          "description": "Espécie introduzida no Brasil; a ficha do álbum precisa dizer isso (Game Design, p. 8).",
          "type": "boolean"
        },
        "fight": {
          "description": "Perfil de briga no mini-jogo de tensão (Game Design, p. 9; P-10).",
          "enum": ["standard", "jumper", "deep_puller", "burst_snagger", "breather", "three_phase_boss"]
        }
      }
    }
  }
}
