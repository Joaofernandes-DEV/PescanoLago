{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Joaofernandes-DEV/PescanoLago/schemas/species.schema.json",
  "title": "Espécies de peixe",
  "description": "Catálogo de espécies do Game Design (p. 8-9). Números são valores iniciais de balanceamento.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "species"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "species": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "common_name",
          "scientific_name",
          "rarity",
          "regions",
          "ideal_baits",
          "max_weight_kg",
          "points",
          "introduced_in_brazil",
          "fight"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "common_name": {
            "type": "string",
            "minLength": 2,
            "description": "Nome popular em pt-BR, como no Game Design."
          },
          "scientific_name": {
            "type": "string",
            "pattern": "^[A-Z][a-z]+ ([a-z]+|sp\\.)$",
            "description": "Gênero e epíteto (ou 'sp.'), como no Game Design."
          },
          "rarity": {
            "enum": [
              "common",
              "uncommon",
              "rare",
              "epic",
              "legendary",
              "unique_legendary"
            ]
          },
          "regions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "ideal_baits": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "max_weight_kg": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "points": {
            "type": "integer",
            "minimum": 1
          },
          "introduced_in_brazil": {
            "type": "boolean",
            "description": "A ficha do álbum precisa dizer que a espécie é introduzida (GDD, p. 8)."
          },
          "fight": {
            "enum": [
              "standard",
              "jumper",
              "deep_puller",
              "burst_snagger",
              "breather",
              "three_phase_boss"
            ],
            "description": "Perfil de briga no mini-jogo de tensão (GDD, p. 9; P-10)."
          },
          "fictional": {
            "type": "boolean",
            "description": "Espécie fictícia (Rei do Lago)."
          },
          "surface": {
            "description": "Peixe de superfície (GDD: tucunaré e dourado); o motor barulhento o espanta.",
            "type": "boolean"
          }
        }
      }
    }
  }
}
