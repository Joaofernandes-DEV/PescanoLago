{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Joaofernandes-DEV/PescanoLago/schemas/release.schema.json",
  "title": "Recorte da versão (flags)",
  "description": "O que está ligado nesta versão. O MVP (GDD, p. 11-12) liga só parte do conteúdo.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "max_upgrade_level",
    "enabled_upgrades",
    "enabled_rods",
    "enabled_baits",
    "enabled_regions",
    "enabled_variants",
    "supported_fight_profiles",
    "days"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "mode": {
      "enum": [
        "mvp",
        "full"
      ]
    },
    "max_upgrade_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "enabled_upgrades": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "enabled_rods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "enabled_baits": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "enabled_regions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "enabled_variants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "supported_fight_profiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "standard",
          "jumper",
          "deep_puller",
          "burst_snagger",
          "breather",
          "three_phase_boss"
        ]
      }
    },
    "days": {
      "type": "integer",
      "minimum": 1
    }
  }
}
