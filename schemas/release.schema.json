{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Joaofernandes-DEV/PescanoLago/schemas/release.schema.json",
  "title": "Recorte da versão (perfis)",
  "description": "O que está ligado em cada perfil. O MVP (GDD, p. 11-12) liga só parte do conteúdo; o perfil full é o lago inteiro (Fase 6). O jogo usa o perfil 'active'; testes e simulador escolhem o perfil.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "active",
    "profiles"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "active": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/profile"
      }
    }
  },
  "$defs": {
    "id_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mode",
        "max_upgrade_level",
        "enabled_upgrades",
        "enabled_rods",
        "enabled_baits",
        "enabled_regions",
        "enabled_variants",
        "supported_fight_profiles",
        "days"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "mode": {
          "enum": [
            "mvp",
            "full"
          ]
        },
        "max_upgrade_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "enabled_upgrades": {
          "$ref": "#/$defs/id_list"
        },
        "enabled_rods": {
          "$ref": "#/$defs/id_list"
        },
        "enabled_baits": {
          "$ref": "#/$defs/id_list"
        },
        "enabled_regions": {
          "$ref": "#/$defs/id_list"
        },
        "enabled_variants": {
          "$ref": "#/$defs/id_list"
        },
        "enabled_rod_parts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "supported_fight_profiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "standard",
              "jumper",
              "deep_puller",
              "burst_snagger",
              "breather",
              "three_phase_boss"
            ]
          }
        },
        "days": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
