{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Joaofernandes-DEV/PescanoLago/schemas/characters.schema.json",
  "title": "Elenco da história",
  "description": "Personagens da campanha dos dias 1 a 8 (P-33, historia-dias-1-a-8.md): o nome no balão de fala, o modelo do Blender (char_<model>.glb) e a voz curta (um som de game/assets/audio/sfx). stand_in marca quem ainda usa o modelo de outro personagem até ganhar o próprio (Fase 7, Bloco B, item 4).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "characters"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "model",
          "stand_in"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "enum": [
              "tom",
              "bolota",
              "maro",
              "zeca"
            ]
          },
          "voice": {
            "description": "Som curto tocado a cada poucas letras do balão (sem voz = balão mudo).",
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "stand_in": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
