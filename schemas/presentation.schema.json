{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Joaofernandes-DEV/PescanoLago/schemas/presentation.schema.json",
  "title": "Apresentação",
  "description": "Parâmetros de apresentação (cenário, navegação, câmera, luz por período, água). Cores das fases vêm de art/STYLE_GUIDE.md. Não são números de balanceamento.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lake",
    "navigation",
    "schools",
    "dock",
    "hub",
    "camera",
    "casting",
    "phases",
    "phase_blend_s",
    "water",
    "rendering"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "lake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shore_radius_m",
        "boat_limit_radius_m",
        "lakebed_depth_m",
        "dock_angle_deg"
      ],
      "properties": {
        "shore_radius_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "boat_limit_radius_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "lakebed_depth_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dock_angle_deg": {
          "type": "number"
        }
      }
    },
    "navigation": {
      "description": "Física do barco (BoatController): velocidade e empuxo, arrasto, quilha, guinada, colisão do casco e flutuação.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_speed_m_s",
        "acceleration_m_s2",
        "reverse_thrust_ratio",
        "linear_drag",
        "lateral_drag",
        "turn_rate_deg_s",
        "yaw_response",
        "prop_turn",
        "stopped_speed_m_s",
        "hull_circle_radius_m",
        "hull_circle_offset_m",
        "restitution",
        "wall_friction",
        "flotation"
      ],
      "properties": {
        "base_speed_m_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "acceleration_m_s2": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reverse_thrust_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "linear_drag": {
          "type": "number",
          "minimum": 0
        },
        "lateral_drag": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "turn_rate_deg_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "yaw_response": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "prop_turn": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "stopped_speed_m_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "hull_circle_radius_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "hull_circle_offset_m": {
          "type": "number",
          "minimum": 0
        },
        "restitution": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "wall_friction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "flotation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stiffness",
            "damping",
            "trim_deg",
            "accel_pitch_deg_per_m_s2",
            "bank_deg"
          ],
          "properties": {
            "stiffness": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "damping": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "trim_deg": {
              "type": "number"
            },
            "accel_pitch_deg_per_m_s2": {
              "type": "number"
            },
            "bank_deg": {
              "type": "number"
            }
          }
        }
      }
    },
    "schools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active",
        "radius_m",
        "engage_distance_m",
        "spawn_min_from_boat_m",
        "spawn_max_radius_m",
        "ripple_visible_m"
      ],
      "properties": {
        "active": {
          "type": "integer",
          "minimum": 1
        },
        "radius_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "engage_distance_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "spawn_min_from_boat_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "spawn_max_radius_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ripple_visible_m": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "dock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arrive_radius_m"
      ],
      "properties": {
        "arrive_radius_m": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "hub": {
      "description": "Vista de Porto Manso (hub): câmera olhando o barco atracado no cais e a fase de luz usada.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "camera_distance_m",
        "camera_height_m",
        "camera_side_m",
        "look_height_m",
        "fov_deg",
        "light_phase"
      ],
      "properties": {
        "camera_distance_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "camera_height_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "camera_side_m": {
          "type": "number"
        },
        "look_height_m": {
          "type": "number",
          "minimum": 0
        },
        "fov_deg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "light_phase": {
          "enum": [
            "dawn",
            "day",
            "dusk",
            "night"
          ]
        }
      }
    },
    "camera": {
      "description": "Câmera do dia (FollowCamera): distância, altura, suavização, atraso da direção, olhar à frente e campo de visão.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distance_m",
        "height_m",
        "follow_speed",
        "yaw_follow",
        "look_ahead_m",
        "look_height_m",
        "fov_deg",
        "fov_speed_boost_deg"
      ],
      "properties": {
        "distance_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "follow_speed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "yaw_follow": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "look_ahead_m": {
          "type": "number",
          "minimum": 0
        },
        "look_height_m": {
          "type": "number",
          "minimum": 0
        },
        "fov_deg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fov_speed_boost_deg": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "casting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "charge_time_s",
        "aim_tolerance_deg"
      ],
      "properties": {
        "charge_time_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "aim_tolerance_deg": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dawn",
        "day",
        "dusk",
        "night"
      ],
      "properties": {
        "dawn": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sun_color",
            "sun_energy",
            "sun_elevation_deg",
            "sky_top",
            "sky_horizon",
            "ambient"
          ],
          "properties": {
            "sun_color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "sun_energy": {
              "type": "number",
              "minimum": 0
            },
            "sun_elevation_deg": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "sky_top": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "sky_horizon": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "ambient": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            }
          }
        },
        "day": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sun_color",
            "sun_energy",
            "sun_elevation_deg",
            "sky_top",
            "sky_horizon",
            "ambient"
          ],
          "properties": {
            "sun_color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "sun_energy": {
              "type": "number",
              "minimum": 0
            },
            "sun_elevation_deg": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "sky_top": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "sky_horizon": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "ambient": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            }
          }
        },
        "dusk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sun_color",
            "sun_energy",
            "sun_elevation_deg",
            "sky_top",
            "sky_horizon",
            "ambient"
          ],
          "properties": {
            "sun_color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "sun_energy": {
              "type": "number",
              "minimum": 0
            },
            "sun_elevation_deg": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "sky_top": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "sky_horizon": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "ambient": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            }
          }
        },
        "night": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sun_color",
            "sun_energy",
            "sun_elevation_deg",
            "sky_top",
            "sky_horizon",
            "ambient"
          ],
          "properties": {
            "sun_color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "sun_energy": {
              "type": "number",
              "minimum": 0
            },
            "sun_elevation_deg": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "sky_top": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "sky_horizon": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "ambient": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            }
          }
        }
      }
    },
    "phase_blend_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "water": {
      "description": "Água do lago (shaders/water.gdshader e LakeWater): cores, espuma, Fresnel, ondas de águas profundas e esteira do barco.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shallow_color",
        "deep_color",
        "foam_color",
        "shore_foam_m",
        "fresnel_strength",
        "detail_strength",
        "waves",
        "wake"
      ],
      "properties": {
        "shallow_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "deep_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "foam_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "shore_foam_m": {
          "type": "number",
          "minimum": 0
        },
        "fresnel_strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "detail_strength": {
          "type": "number",
          "minimum": 0
        },
        "waves": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dir_deg",
              "wavelength_m",
              "amplitude_m",
              "phase"
            ],
            "properties": {
              "dir_deg": {
                "type": "number"
              },
              "wavelength_m": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "amplitude_m": {
                "type": "number",
                "minimum": 0
              },
              "phase": {
                "type": "number"
              }
            }
          }
        },
        "wake": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "interval_s",
            "life_s",
            "spread_m_s",
            "min_speed_m_s"
          ],
          "properties": {
            "interval_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "life_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "spread_m_s": {
              "type": "number",
              "minimum": 0
            },
            "min_speed_m_s": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "rendering": {
      "description": "Ambiente de renderização (DayLighting): tonemap AgX com exposição, glow, SSAO (só Forward+), névoa, cor e sombras do sol.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exposure",
        "glow_intensity",
        "glow_bloom",
        "ssao",
        "fog_density",
        "saturation",
        "contrast",
        "shadow_max_distance_m",
        "shadow_blur",
        "sun_angular_size_deg",
        "sun_disk_deg"
      ],
      "properties": {
        "exposure": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "glow_intensity": {
          "type": "number",
          "minimum": 0
        },
        "glow_bloom": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ssao": {
          "type": "boolean"
        },
        "fog_density": {
          "type": "number",
          "minimum": 0
        },
        "saturation": {
          "type": "number",
          "minimum": 0
        },
        "contrast": {
          "type": "number",
          "minimum": 0
        },
        "shadow_max_distance_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "shadow_blur": {
          "type": "number",
          "minimum": 0
        },
        "sun_angular_size_deg": {
          "type": "number",
          "minimum": 0
        },
        "sun_disk_deg": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
