{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Joaofernandes-DEV/PescanoLago/schemas/presentation.schema.json",
  "title": "Apresentação",
  "description": "Parâmetros de apresentação (cenário, navegação, câmera, luz por período, água). Cores das fases vêm de art/STYLE_GUIDE.md. Não são números de balanceamento.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lake",
    "navigation",
    "schools",
    "dock",
    "birds",
    "animals",
    "buoys",
    "fish",
    "hub",
    "camera",
    "casting",
    "hints",
    "landing",
    "minimap",
    "phases",
    "phase_blend_s",
    "water",
    "region_looks",
    "title",
    "settings",
    "rendering"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "lake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shore_radius_m",
        "boat_limit_radius_m",
        "lakebed_depth_m",
        "dock_angle_deg"
      ],
      "properties": {
        "shore_radius_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "boat_limit_radius_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "lakebed_depth_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dock_angle_deg": {
          "type": "number"
        }
      }
    },
    "navigation": {
      "description": "Física do barco (BoatController): velocidade e empuxo, arrasto, quilha, guinada, colisão do casco e flutuação.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_speed_m_s",
        "acceleration_m_s2",
        "reverse_thrust_ratio",
        "linear_drag",
        "lateral_drag",
        "turn_rate_deg_s",
        "yaw_response",
        "prop_turn",
        "stopped_speed_m_s",
        "hull_circle_radius_m",
        "hull_circle_offset_m",
        "restitution",
        "wall_friction",
        "flotation"
      ],
      "properties": {
        "base_speed_m_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "acceleration_m_s2": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reverse_thrust_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "linear_drag": {
          "type": "number",
          "minimum": 0
        },
        "lateral_drag": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "turn_rate_deg_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "yaw_response": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "prop_turn": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "stopped_speed_m_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "hull_circle_radius_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "hull_circle_offset_m": {
          "type": "number",
          "minimum": 0
        },
        "restitution": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "wall_friction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "flotation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stiffness",
            "damping",
            "trim_deg",
            "accel_pitch_deg_per_m_s2",
            "bank_deg"
          ],
          "properties": {
            "stiffness": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "damping": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "trim_deg": {
              "type": "number"
            },
            "accel_pitch_deg_per_m_s2": {
              "type": "number"
            },
            "bank_deg": {
              "type": "number"
            }
          }
        }
      }
    },
    "schools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active",
        "radius_m",
        "engage_distance_m",
        "spawn_min_from_boat_m",
        "spawn_max_radius_m",
        "ripple_visible_m"
      ],
      "properties": {
        "active": {
          "type": "integer",
          "minimum": 1
        },
        "radius_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "engage_distance_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "spawn_min_from_boat_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "spawn_max_radius_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ripple_visible_m": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "dock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arrive_radius_m"
      ],
      "properties": {
        "arrive_radius_m": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "birds": {
      "description": "Garças sobrevoando o lago (Birds): quantas, órbitas, altura, velocidade e bater de asas.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "orbit_radius_m",
        "height_m",
        "speed_m_s",
        "flap_hz",
        "flap_deg"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "orbit_radius_m": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "height_m": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "speed_m_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "flap_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "flap_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 80
        }
      }
    },
    "animals": {
      "description": "Animais do cenário (Animals): capivaras pastando na margem (ângulo e ciclo da cabeça), jacarés boiando (quanto andam, em quanto tempo e quanto ficam abaixo da água) e martins-pescadores mergulhando das boias (a cada quantos segundos, quanto dura, quanto avançam e quanto o bico inclina). Os lugares vêm dos pontos LOC_ do cenário e dos poleiros das boias.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capybara",
        "caiman",
        "kingfisher"
      ],
      "properties": {
        "capybara": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "graze_deg",
            "graze_cycle_s"
          ],
          "properties": {
            "graze_deg": {
              "type": "number",
              "minimum": 0,
              "maximum": 80
            },
            "graze_cycle_s": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "caiman": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "drift_m",
            "drift_cycle_s",
            "depth_m"
          ],
          "properties": {
            "drift_m": {
              "type": "number",
              "minimum": 0
            },
            "drift_cycle_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "depth_m": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "kingfisher": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dive_every_s",
            "dive_s",
            "reach_m",
            "pitch_deg"
          ],
          "properties": {
            "dive_every_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "dive_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "reach_m": {
              "type": "number",
              "minimum": 0
            },
            "pitch_deg": {
              "type": "number",
              "minimum": 0,
              "maximum": 90
            }
          }
        }
      }
    },
    "buoys": {
      "description": "Boias antigas (Buoys): quanto do flutuador fica abaixo da água e quanto a boia acompanha a inclinação da onda (0 = sempre em pé, 1 = a normal da água).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draft_m",
        "tilt_scale"
      ],
      "properties": {
        "draft_m": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.5
        },
        "tilt_scale": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "fish": {
      "description": "Peixes na tela (FishLooks, FishingRig): escala pelo peso, salto e cores das variantes.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_weight_ratio",
        "scale_min",
        "scale_max",
        "jump_height_m",
        "variants"
      ],
      "properties": {
        "reference_weight_ratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "scale_min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "scale_max": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "jump_height_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "variants": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "body",
              "eye",
              "pupil"
            ],
            "properties": {
              "body": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "eye": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "pupil": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              }
            }
          }
        }
      }
    },
    "hub": {
      "description": "Vista de Porto Manso (hub): câmera olhando o barco atracado no cais e a fase de luz usada.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "camera_distance_m",
        "camera_height_m",
        "camera_side_m",
        "camera_h_offset_m",
        "look_height_m",
        "look_inland_m",
        "fov_deg",
        "light_phase"
      ],
      "properties": {
        "camera_distance_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "camera_height_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "camera_side_m": {
          "type": "number"
        },
        "camera_h_offset_m": {
          "type": "number",
          "description": "Desloca o quadro para o lado (Camera3D.h_offset), para o cais e a vila ficarem à esquerda do painel das lojas."
        },
        "look_height_m": {
          "type": "number",
          "minimum": 0
        },
        "look_inland_m": {
          "type": "number",
          "minimum": 0
        },
        "fov_deg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "light_phase": {
          "enum": [
            "dawn",
            "day",
            "dusk",
            "night"
          ]
        }
      }
    },
    "camera": {
      "description": "Câmera do dia (FollowCamera): distância, altura, suavização, atraso da direção, olhar à frente e campo de visão.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distance_m",
        "height_m",
        "follow_speed",
        "yaw_follow",
        "look_ahead_m",
        "look_height_m",
        "fov_deg",
        "fov_speed_boost_deg",
        "close_up_blend_per_s"
      ],
      "properties": {
        "distance_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "follow_speed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "yaw_follow": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "look_ahead_m": {
          "type": "number",
          "minimum": 0
        },
        "look_height_m": {
          "type": "number",
          "minimum": 0
        },
        "fov_deg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fov_speed_boost_deg": {
          "type": "number",
          "minimum": 0
        },
        "close_up_blend_per_s": {
          "description": "Câmera de perto (o Tom mostrando o peixe, a caixa aberta): fração do caminho por segundo.",
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "casting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "charge_time_s",
        "aim_tolerance_deg",
        "flight_apex_per_m",
        "flight_apex_min_m",
        "open_water_aim_fraction",
        "shadow_approach_s",
        "shadow_start_m",
        "shadow_length_m",
        "shadow_opacity"
      ],
      "properties": {
        "charge_time_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "aim_tolerance_deg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "flight_apex_per_m": {
          "type": "number",
          "minimum": 0,
          "description": "Altura do arco da isca no lançamento, por metro de distância."
        },
        "flight_apex_min_m": {
          "type": "number",
          "minimum": 0,
          "description": "Altura mínima do arco da isca (lançamentos curtos)."
        },
        "open_water_aim_fraction": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "shadow_approach_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "shadow_start_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "shadow_length_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "shadow_opacity": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dawn",
        "day",
        "dusk",
        "night"
      ],
      "properties": {
        "dawn": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sun_color",
            "sun_energy",
            "sun_elevation_deg",
            "sky_top",
            "sky_horizon",
            "ambient"
          ],
          "properties": {
            "sun_color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "sun_energy": {
              "type": "number",
              "minimum": 0
            },
            "sun_elevation_deg": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "sky_top": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "sky_horizon": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "ambient": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            }
          }
        },
        "day": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sun_color",
            "sun_energy",
            "sun_elevation_deg",
            "sky_top",
            "sky_horizon",
            "ambient"
          ],
          "properties": {
            "sun_color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "sun_energy": {
              "type": "number",
              "minimum": 0
            },
            "sun_elevation_deg": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "sky_top": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "sky_horizon": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "ambient": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            }
          }
        },
        "dusk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sun_color",
            "sun_energy",
            "sun_elevation_deg",
            "sky_top",
            "sky_horizon",
            "ambient"
          ],
          "properties": {
            "sun_color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "sun_energy": {
              "type": "number",
              "minimum": 0
            },
            "sun_elevation_deg": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "sky_top": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "sky_horizon": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "ambient": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            }
          }
        },
        "night": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sun_color",
            "sun_energy",
            "sun_elevation_deg",
            "sky_top",
            "sky_horizon",
            "ambient"
          ],
          "properties": {
            "sun_color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "sun_energy": {
              "type": "number",
              "minimum": 0
            },
            "sun_elevation_deg": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "sky_top": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "sky_horizon": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "ambient": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            }
          }
        }
      }
    },
    "phase_blend_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "water": {
      "description": "Água do lago (shaders/water.gdshader e LakeWater): cores, espuma, Fresnel, ondas de águas profundas e esteira do barco.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shallow_color",
        "deep_color",
        "foam_color",
        "shore_foam_m",
        "fresnel_strength",
        "detail_strength",
        "waves",
        "wake"
      ],
      "properties": {
        "shallow_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "deep_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "foam_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "shore_foam_m": {
          "type": "number",
          "minimum": 0
        },
        "fresnel_strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "detail_strength": {
          "type": "number",
          "minimum": 0
        },
        "waves": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dir_deg",
              "wavelength_m",
              "amplitude_m",
              "phase"
            ],
            "properties": {
              "dir_deg": {
                "type": "number"
              },
              "wavelength_m": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "amplitude_m": {
                "type": "number",
                "minimum": 0
              },
              "phase": {
                "type": "number"
              }
            }
          }
        },
        "wake": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "interval_s",
            "life_s",
            "spread_m_s",
            "min_speed_m_s"
          ],
          "properties": {
            "interval_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "life_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "spread_m_s": {
              "type": "number",
              "minimum": 0
            },
            "min_speed_m_s": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "region_looks": {
      "description": "Aparência de cada região com cenário próprio (P-32): cores e espuma da margem da água, ondas (wave_scale multiplica as amplitudes de water.waves) e a cor da água no mapa lateral. Região sem entrada usa a da Margem Rasa.",
      "type": "object",
      "required": [
        "margem_rasa"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "water",
          "map_water"
        ],
        "properties": {
          "water": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "shallow_color": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "deep_color": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "shore_foam_m": {
                "type": "number",
                "minimum": 0
              },
              "wave_scale": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 3
              }
            }
          },
          "map_water": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          }
        }
      }
    },
    "title": {
      "description": "Tela inicial (TitleScreen): fase de luz do cenário e a volta lenta da câmera em torno do lago (raio, altura, quanto tempo leva uma volta) olhando a margem um pouco à frente (ângulo à frente, raio e altura do ponto olhado).",
      "type": "object",
