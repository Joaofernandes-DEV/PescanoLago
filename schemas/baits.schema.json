{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Joaofernandes-DEV/PescanoLago/schemas/baits.schema.json",
  "title": "Iscas",
  "description": "Iscas do Game Design (p. 7-8). Naturais são consumíveis e vendidas em lote (P-16); artificiais têm 3 níveis.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lot_size",
    "baits"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "lot_size": {
      "type": "integer",
      "minimum": 1
    },
    "baits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "type",
              "cost_per_unit",
              "attracts"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "name": {
                "type": "string",
                "minLength": 2
              },
              "type": {
                "const": "natural"
              },
              "cost_per_unit": {
                "type": "integer",
                "minimum": 1
              },
              "attracts": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "type",
              "level_costs",
              "attracts",
              "levels"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "name": {
                "type": "string",
                "minLength": 2
              },
              "type": {
                "const": "artificial"
              },
              "level_costs": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                },
                "minItems": 3,
                "maxItems": 3
              },
              "attracts": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              },
              "levels": {
                "description": "Efeito de cada nível (GDD: os níveis aumentam o raio de atração e a chance de variantes raras; P-29).",
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "attraction_radius_m",
                    "variant_chance_bonus"
                  ],
                  "properties": {
                    "attraction_radius_m": {
                      "type": "number",
                      "minimum": 0
                    },
                    "variant_chance_bonus": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "type",
              "unlock",
              "attracts"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "name": {
                "type": "string",
                "minLength": 2
              },
              "type": {
                "const": "special"
              },
              "unlock": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "attracts": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              }
            }
          }
        ]
      }
    }
  }
}
