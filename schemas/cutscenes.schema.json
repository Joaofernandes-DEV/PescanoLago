{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Joaofernandes-DEV/PescanoLago/schemas/cutscenes.schema.json",
  "title": "Cutscenes da história",
  "description": "Cutscenes em passos (P-40, historia-dias-1-a-8.md). As posições são em metros no espaço do ponto anchor do cenário (x para a direita dele, z para a frente; a câmera também tem a altura y). actors: quem está na cena, onde começa e para onde olha (graus, 0 = a frente do ponto). Passos: talk (uma conversa de dialogues.json), walk (andar ou correr até um ponto), gesture (um gesto por seconds; hold mantém a pose até o fim), camera (ir até position olhando look_at, que é um ponto ou os personagens, em seconds; 0 = corte), wait e card (cartela com texto na tela escura). together: o passo seguinte começa junto.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cutscenes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "cutscenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "day",
          "scene",
          "anchor",
          "actors",
          "steps"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "day": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "scene": {
            "type": "string",
            "minLength": 1
          },
          "anchor": {
            "type": "string",
            "pattern": "^LOC_[a-z0-9_]+$"
          },
          "actors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "at",
                "face_deg"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "at": {
                  "$ref": "#/$defs/point2"
                },
                "face_deg": {
                  "type": "number"
                }
              }
            }
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/step"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "point2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "point3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "seconds": {
      "type": "number",
      "minimum": 0
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "dialogue"
          ],
          "properties": {
            "type": {
              "const": "talk"
            },
            "dialogue": {
              "$ref": "#/$defs/id"
            },
            "together": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "actor",
            "to"
          ],
          "properties": {
            "type": {
              "const": "walk"
            },
            "actor": {
              "$ref": "#/$defs/id"
            },
            "to": {
              "$ref": "#/$defs/point2"
            },
            "run": {
              "type": "boolean"
            },
            "face_deg": {
              "type": "number"
            },
            "together": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "actor",
            "gesture",
            "seconds"
          ],
          "properties": {
            "type": {
              "const": "gesture"
            },
            "actor": {
              "$ref": "#/$defs/id"
            },
            "gesture": {
              "type": "string",
              "enum": [
                "point",
                "hands_on_hips",
                "cross_arms",
                "scratch_head",
                "belly_pat",
                "look_around",
                "wave",
                "cheer",
                "bark",
                "sit",
                "lie_down"
              ]
            },
            "toward": {
              "description": "Para onde o gesto vira (a cabeça e o corpo): outro personagem ou um ponto.",
              "oneOf": [
                {
                  "$ref": "#/$defs/id"
                },
                {
                  "$ref": "#/$defs/point2"
                }
              ]
            },
            "seconds": {
              "$ref": "#/$defs/seconds"
            },
            "hold": {
              "type": "boolean"
            },
            "together": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "position",
            "look_at",
            "seconds"
          ],
          "properties": {
            "type": {
              "const": "camera"
            },
            "position": {
              "$ref": "#/$defs/point3"
            },
            "look_at": {
              "oneOf": [
                {
                  "$ref": "#/$defs/point3"
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/id"
                  }
                }
              ]
            },
            "seconds": {
              "$ref": "#/$defs/seconds"
            },
            "together": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "seconds"
          ],
          "properties": {
            "type": {
              "const": "wait"
            },
            "seconds": {
              "$ref": "#/$defs/seconds"
            },
            "together": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "seconds"
          ],
          "properties": {
            "type": {
              "const": "card"
            },
            "text": {
              "type": "string",
              "maxLength": 120
            },
            "seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "together": {
              "type": "boolean"
            }
          }
        }
      ]
    }
  }
}
