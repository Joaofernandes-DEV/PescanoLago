{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Joaofernandes-DEV/PescanoLago/schemas/rods.schema.json",
  "title": "Varas",
  "description": "Varas do Game Design (p. 7). A força de recolhimento vira velocidade em m/s (P-18).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reel_speed_m_s",
    "rods",
    "part_slots",
    "parts"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "reel_speed_m_s": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "low",
        "medium",
        "medium_high",
        "high",
        "max"
      ],
      "properties": {
        "low": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "medium": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "medium_high": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "high": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "rods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "range_m",
          "line_strength_kg",
          "reel_power",
          "hook_window_s",
          "cost"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 2
          },
          "range_m": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "line_strength_kg": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "reel_power": {
            "enum": [
              "low",
              "medium",
              "medium_high",
              "high",
              "max"
            ]
          },
          "hook_window_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "cost": {
            "type": "integer",
            "minimum": 0
          },
          "requires_mission": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      }
    },
    "part_slots": {
      "description": "Peças extras por vara (GDD: slots de até 2 peças).",
      "type": "integer",
      "minimum": 0
    },
    "parts": {
      "description": "Peças extras das varas (GDD p. 7; números na P-29). Cada peça é comprada uma vez e montada numa vara.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "cost",
          "effects"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 2
          },
          "cost": {
            "type": "integer",
            "minimum": 1
          },
          "effects": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "reel_speed_factor": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "line_strength_factor": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "hook_window_bonus_s": {
                "type": "number",
                "minimum": 0
              },
              "night_bite_wait_factor": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    }
  }
}
