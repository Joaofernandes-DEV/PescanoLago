{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Joaofernandes-DEV/PescanoLago/schemas/dialogues.schema.json",
  "title": "Roteiros dos diálogos",
  "description": "Falas dos balões da campanha (historia-dias-1-a-8.md), na ordem: cada fala é um balão preso a quem fala (characters.json) e avança com um clique (P-39). style: balão normal (say), de grito (shout) ou de cochicho (whisper).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dialogues"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "dialogues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "day",
          "scene",
          "lines"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "day": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "scene": {
            "description": "Onde a conversa está no roteiro (para quem edita).",
            "type": "string",
            "minLength": 1
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "speaker",
                "text"
              ],
              "properties": {
                "speaker": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "style": {
                  "type": "string",
                  "enum": [
                    "say",
                    "shout",
                    "whisper"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
