{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Joaofernandes-DEV/PescanoLago/schemas/regions.schema.json",
  "title": "Regiões do lago",
  "description": "Regiões e regras de liberação (GDD, p. 9-10); tabelas de surgimento (P-12).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "regions"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind",
          "unlock",
          "spawns"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 2
          },
          "kind": {
            "enum": [
              "hub",
              "fishing"
            ]
          },
          "unlock": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {
              "min_day": {
                "type": "integer",
                "minimum": 1
              },
              "min_boat_level": {
                "type": "integer",
                "minimum": 1
              },
              "min_upgrade_levels": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                }
              }
            }
          },
          "spawns": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "species",
                "weight",
                "period_multipliers"
              ],
              "properties": {
                "species": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "weight": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "period_multipliers": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "dawn",
                    "day",
                    "dusk",
                    "night"
                  ],
                  "properties": {
                    "dawn": {
                      "type": "number",
                      "minimum": 0
                    },
                    "day": {
                      "type": "number",
                      "minimum": 0
                    },
                    "dusk": {
                      "type": "number",
                      "minimum": 0
                    },
                    "night": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                },
                "mvp_only": {
                  "type": "boolean",
                  "description": "Exceção do MVP (P-01): espécie fora da sua região do GDD."
                },
                "secondary": {
                  "type": "boolean",
                  "description": "Acompanhante (P-29): espécie de uma região vizinha, com peso baixo, para a região ter peixes além dos principais."
                }
              }
            }
          },
          "permanent_events": {
            "description": "Eventos o dia todo nesta região (Ilha da Névoa: \"névoa permanente\", GDD p. 9).",
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "frenzy",
                "fog",
                "net"
              ]
            }
          }
        }
      }
    }
  }
}
