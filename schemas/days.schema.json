{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Joaofernandes-DEV/PescanoLago/schemas/days.schema.json",
  "title": "Dias de pesca",
  "description": "Dias com meta e pontuação-alvo (GDD, p. 11; P-05, P-06, P-19, P-26). mvp_override troca campos do dia no perfil MVP.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "days"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "day",
          "duration_s",
          "region",
          "goal",
          "target_score"
        ],
        "properties": {
          "day": {
            "type": "integer",
            "minimum": 1
          },
          "duration_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "region": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "goal": {
            "$ref": "#/$defs/goal"
          },
          "target_score": {
            "type": "integer",
            "minimum": 1
          },
          "mvp_override": {
            "description": "Como o dia era no MVP (dias 9 e 10 na Margem Rasa; P-26).",
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "duration_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "region": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "goal": {
                "$ref": "#/$defs/goal"
              },
              "target_score": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "weather": {
            "description": "Clima fixo do dia (GDD: dias 23 a 29 com tempestade ou névoa). Sem ele, o clima é sorteado.",
            "enum": [
              "sun",
              "cloudy",
              "rain",
              "storm"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "fish_count",
            "score",
            "species_count"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "score": {
          "type": "integer",
          "minimum": 1
        },
        "species": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "species_count": {
          "type": "integer",
          "minimum": 1
        },
        "min_rarity": {
          "enum": [
            "common",
            "uncommon",
            "rare",
            "epic",
            "legendary",
            "unique_legendary"
          ]
        },
        "min_rarity_count": {
          "type": "integer",
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "fish_count"
              }
            }
          },
          "then": {
            "required": [
              "count"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "score"
              }
            }
          },
          "then": {
            "required": [
              "score"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "species_count"
              }
            }
          },
          "then": {
            "required": [
              "species",
              "count"
            ]
          }
        },
        {
          "dependentRequired": {
            "min_rarity": [
              "min_rarity_count"
            ],
            "min_rarity_count": [
              "min_rarity"
            ],
            "species_count": [
              "species"
            ]
          }
        }
      ]
    }
  }
}
